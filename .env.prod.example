# Configurações de Produção - OCI (Oracle Cloud Infrastructure)
# Copie este arquivo para .env na raiz do projeto na VPS:
# cp .env.prod.example .env

# Banco de Dados
MYSQL_DATABASE=daily_autism_db
MYSQL_ROOT_PASSWORD=DefinaUmaSenhaRootForteAqui123!
MYSQL_USER=daily_user
MYSQL_PASSWORD=DefinaUmaSenhaUsuarioForteAqui123!

# Segurança / Autenticação JWT (deve ter 256 bits / 32+ caracteres)
JWT_SECRET=ChaveSuperSecretaProducaoDailyAutismJwtSecurity2026TokenMustBe256BitsLong!

# CORS (origens aceitas pelo Spring Boot)
# Ao publicar por IP público, pode usar * ou http://SEU_IP_PUBLICO
CORS_ALLOWED_ORIGINS=*

# URL da API para o Frontend (se vazio, usa o proxy reverso /api configurado no Nginx)
# Ou informe explicitamente se preferir: http://SEU_IP_PUBLICO:8080
VITE_API_URL=

# Credenciais iniciais do Administrador (usadas apenas se ainda não existir ADMIN no banco)
ADMIN_INITIAL_EMAIL=admin@dailyautism.com
ADMIN_INITIAL_PASSWORD=

# Login com Google OAuth2 (Web Client ID gerado no Google Cloud Console)
# O mesmo Web Client ID é usado no Backend, no Frontend Web e como serverClientId no App Android (DApp)
GOOGLE_OAUTH_WEB_CLIENT_ID=
# Opcional: Client IDs adicionais separados por vírgula (ex: Android/iOS)
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=
