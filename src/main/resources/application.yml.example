spring:
  jackson:
    default-property-inclusion: non-null
  application:
    name: DailyAutism
  datasource:
    url: jdbc:mysql://localhost:3306/dailyautism
    username: admin
    password: teste123
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    generate-ddl: true
    hibernate.ddl-auto: update
    repositories.enabled: true
    database: mysql

api:
  security:
    token:
      secret: ${JWT_SECRET:DailyAutismSecretKeyForJwtTokenGenerationMustBe256BitsLong2026!}

cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173}
